format gbcli-pixels 1
# Elle, the worker: three 16x48 frames.
#   0 from behind, facing the Finished belt: long wavy hair to her waist
#   1 from the front, facing the parts belt: full bangs, the choker, the
#     denim top with its row of buttons
#   2 from the side, mid-turn (facing right)
# DMG shades: white skin, light gray hair and denim, black ink. Each 8x16
# object keeps to three colors so a GBC can color it by its own palette
# (src/colors.asm): the head blonde with a plum choker, the top denim blue,
# the hair down her back blonde, the skirt navy. Gray art, so one tile set
# serves both machines (gbcli help images).
size 48 48
color . clear
color w #ffffff   # skin
color l #aaaaaa   # hair, denim
color k #000000   # ink, choker, skirt, shoes

rows 0 0    # frame 0: from behind

+        ));
+        let _ = fs::remove_dir_all(&dir);
+        fs::create_dir_all(&dir).unwrap();
+        Scratch(dir)
+    }
+
+    fn entries(&self) -> Vec<PathBuf> {
+        fs::read_dir(&self.0)
+            .map(|dir| dir.map(|e| e.unwrap().path()).collect())
+            .unwrap_or_default()
+    }
+}
+
+impl Drop for Scratch {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.0);
+    }
+}
+
+/// Replaces the version line of the one entry in `dir`.
+fn rewrite_line(dir: &Scratch, line: &str) {
+    let entries = dir.entries();
+    assert_eq!(entries.len(), 1, "{entries:?}");
+    let text = fs::read_to_string(&entries[0]).unwrap();
+    let key = text.lines().next().unwrap();
+    fs::write(&entries[0], format!("{key}\n{line}\n")).unwrap();
+}
+
+#[test]
+fn a_cached_probe_reads_a_compiled_tool_once_and_others_trust_the_entry() {
+    let path = real_path();
+    let dir = Scratch::new("trust");
+    let first = probe_with(
+        &cache::VersionCache::new(),
+        Tool::Rgbasm,
+        Some(&path),
+        Path::new("/"),
+        Some(&dir.0),
+    )
+    .expect("RGBDS on PATH");
+    assert_eq!(
+        dir.entries().len(),
+        1,
+        "the line was kept for other processes"
+    );
+    // The entry says another patch; a process that believes it never runs
+    // the tool, so the answer is the entry's.
+    rewrite_line(&dir, "rgbasm v1.0.9");
+    let second = probe_with(
+        &cache::VersionCache::new(),
+        Tool::Rgbasm,
+        Some(&path),
+        Path::new("/"),
+        Some(&dir.0),
+    )
+    .unwrap();
+    assert_eq!(second.version, Version::release(1, 0, 9));
+    assert_eq!(second.path, first.path);
+    // With no directory, and a memory of its own, the tool is run.
+    let alone = probe_with(
+        &cache::VersionCache::new(),
+        Tool::Rgbasm,
+        Some(&path),
+        Path::new("/"),
+        None,
+    )
+    .unwrap();
+    assert_eq!(alone.version, first.version);
+}
+
+#[test]
+fn an_entry_is_held_to_the_pin_like_a_fresh_reading() {
+    let path = real_path();
+    let dir = Scratch::new("pin");
+    let fresh = || cache::VersionCache::new();
+    probe_with(
+        &fresh(),
+        Tool::Rgbasm,
+        Some(&path),
+        Path::new("/"),
+        Some(&dir.0),
+    )
+    .unwrap();
+    rewrite_line(&dir, "rgbasm v2.0.0");
+    let refused = probe_with(
+        &fresh(),
+        Tool::Rgbasm,
+        Some(&path),
+        Path::new("/"),
+        Some(&dir.0),
+    )
+    .unwrap_err();
+    assert!(
+        matches!(refused, ToolProblem::Unsupported { .. }),
+        "{refused:?}"
+    );
+}
+
+#[test]
+fn an_entry_that_does_not_read_as_a_version_is_run_again() {
+    let path = real_path();
+    let dir = Scratch::new("garbled");
+    let fresh = || cache::VersionCache::new();
+    let first = probe_with(
+        &fresh(),
+        Tool::Rgbasm,
+        Some(&path),
+        Path::new("/"),
+        Some(&dir.0),
+    )
+    .unwrap();
+    rewrite_line(&dir, "no version here");
+    let again = probe_with(
+        &fresh(),
+        Tool::Rgbasm,
+        Some(&path),
+        Path::new("/"),
+        Some(&dir.0),
+    )
+    .unwrap();
+    assert_eq!(again.version, first.version);
+}
+
+#[test]
+fn a_script_is_run_every_time_whatever_the_cache() {
+    // The fake tools are scripts: nothing is kept, in memory or on disk, so a
+    // wrapper that changes its answer is read again.
+    let fake = fake("uncached", &all("v1.0.4"));
+    let dir = Scratch::new("script");
+    let cache = cache::VersionCache::new();
+    let probe = || {
+        probe_with(
+            &cache,
+            Tool::Rgbasm,
+            Some(&fake.var()),
+            Path::new("/"),
+            Some(&dir.0),
+        )
+    };
+    assert_eq!(probe().unwrap().version, Version::release(1, 0, 4));
+    assert!(dir.entries().is_empty(), "{:?}", dir.entries());
+    fs::write(fake.0.join("rgbasm"), "#!/bin/sh\necho 'rgbasm v1.0.6'\n").unwrap();
+    assert_eq!(probe().unwrap().version, Version::release(1, 0, 6));
+}
+
+#[test]
+fn a_cached_discovery_finds_the_same_tools_as_an_uncached_one() {
+    let path = real_path();
+    let plain = Toolchain::discover(Some(&path), Path::new("/")).unwrap();
+    let dir = Scratch::new("discover");
+    for _ in 0..2 {
+        let cached = Toolchain::discover_cached(Some(&path), Path::new("/"), Some(&dir.0)).unwrap();
+        for tool in Tool::ALL {
+            assert_eq!(cached.path(tool), plain.path(tool));
+        }
+        assert_eq!(cached.version(), plain.version());
+    }
+    assert_eq!(dir.entries().len(), 3, "one entry a tool");
+}
+
+#[test]
+fn a_missing_tool_is_missing_whatever_the_cache() {
+    let dir = Scratch::new("missing");
+    let err = probe_cached(
+        Tool::Rgbasm,
+        Some(Path::new("/no/such/dir").as_os_str()),
+        Path::new("/"),
+        Some(&dir.0),
+    )
+    .unwrap_err();
+    assert_eq!(err, ToolProblem::Missing { tool: Tool::Rgbasm });
+}

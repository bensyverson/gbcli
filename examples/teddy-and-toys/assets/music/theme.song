format gbcli-song 1
name "Teddy & Toys"
artist "gbcli factory agent"
comment "A bouncy, loopy factory tune. Channel 1 stays empty: it is the sound effects' (src/sound.asm), and the music keeps its volumes low so the effects sit on top."
ticks_per_row 6

# A soft, rounded wave for the oom-pah bass.
wave 0 0123456789ABCDEFFEDCBA9876543210

instrument square 1 "Lead"
  envelope 4 down 1
  duty 25%

instrument wave 1 "Bass"
  level 25%
  waveform 0

instrument noise 1 "Hat"
  length 2
  envelope 2 down 1
  mode 7-bit

instrument noise 2 "Kick"
  envelope 3 down 1

instrument noise 3 "Snare"
  envelope 2 down 1

orders
00 P0 P1 P3 P5
01 P0 P2 P4 P5

# Channel 1: nothing, ever (the effects' channel).
pattern P0
00 ... .. ... ...

# Lead A over C | F | G | C, short notes (the envelope fades each one).
# No note cuts: a cut turns the DAC off, and every DAC switch pops at
# full volume, louder than the notes.
pattern P1
00 C-6 01 ... ...
02 E-6 01 ... ...
04 G-6 01 ... ...
06 E-6 01 ... ...
08 C-7 01 ... ...
11 G-6 01 ... ...
12 A-6 01 ... ...
14 G-6 01 ... ...
16 A-6 01 ... ...
18 F-6 01 ... ...
20 C-7 01 ... ...
22 A-6 01 ... ...
24 F-6 01 ... ...
27 A-6 01 ... ...
28 C-7 01 ... ...
30 A-6 01 ... ...
32 B-6 01 ... ...
34 G-6 01 ... ...
36 D-7 01 ... ...
38 B-6 01 ... ...
40 G-6 01 ... ...
43 B-6 01 ... ...
44 D-7 01 ... ...
46 F-6 01 ... ...
48 E-6 01 ... ...
50 G-6 01 ... ...
52 C-7 01 ... ...
56 G-6 01 ... ...
58 E-6 01 ... ...
60 D-6 01 ... ...
62 C-6 01 ... ...

# Lead B over Am | F | G | G7, climbing back to the top.
pattern P2
00 A-6 01 ... ...
02 C-7 01 ... ...
04 E-7 01 ... ...
06 C-7 01 ... ...
08 A-6 01 ... ...
10 E-6 01 ... ...
12 A-6 01 ... ...
14 B-6 01 ... ...
16 C-7 01 ... ...
18 A-6 01 ... ...
20 F-6 01 ... ...
22 A-6 01 ... ...
24 C-7 01 ... ...
26 D-7 01 ... ...
28 C-7 01 ... ...
30 A-6 01 ... ...
32 B-6 01 ... ...
34 D-7 01 ... ...
36 G-7 01 ... ...
38 D-7 01 ... ...
40 B-6 01 ... ...
42 G-6 01 ... ...
44 B-6 01 ... ...
46 D-7 01 ... ...
48 D-7 01 ... ...
50 B-6 01 ... ...
52 G-6 01 ... ...
54 F-6 01 ... ...
56 D-6 01 ... ...
58 F-6 01 ... ...
60 G-6 01 ... ...
62 B-6 01 ... ...

# Bass A: root, octave, root, octave (the wave sounds two octaves below
# its name: C-4 is C2).
pattern P3
00 C-4 01 ... ...
02 C-5 01 ... ...
04 C-4 01 ... ...
06 C-5 01 ... ...
08 C-4 01 ... ...
10 C-5 01 ... ...
12 G-4 01 ... ...
14 C-5 01 ... ...
16 F-4 01 ... ...
18 F-5 01 ... ...
20 F-4 01 ... ...
22 F-5 01 ... ...
24 F-4 01 ... ...
26 F-5 01 ... ...
28 C-5 01 ... ...
30 F-5 01 ... ...
32 G-4 01 ... ...
34 G-5 01 ... ...
36 G-4 01 ... ...
38 G-5 01 ... ...
40 G-4 01 ... ...
42 G-5 01 ... ...
44 D-5 01 ... ...
46 G-5 01 ... ...
48 C-4 01 ... ...
50 C-5 01 ... ...
52 C-4 01 ... ...
54 C-5 01 ... ...
56 G-4 01 ... ...
58 C-5 01 ... ...
60 G-4 01 ... ...
62 B-4 01 ... ...

# Bass B: Am | F | G | G7.
pattern P4
00 A-4 01 ... ...
02 A-5 01 ... ...
04 A-4 01 ... ...
06 A-5 01 ... ...
08 A-4 01 ... ...
10 A-5 01 ... ...
12 E-5 01 ... ...
14 A-5 01 ... ...
16 F-4 01 ... ...
18 F-5 01 ... ...
20 F-4 01 ... ...
22 F-5 01 ... ...
24 F-4 01 ... ...
26 F-5 01 ... ...
28 C-5 01 ... ...
30 F-5 01 ... ...
32 G-4 01 ... ...
34 G-5 01 ... ...
36 G-4 01 ... ...
38 G-5 01 ... ...
40 G-4 01 ... ...
42 G-5 01 ... ...
44 D-5 01 ... ...
46 G-5 01 ... ...
48 G-4 01 ... ...
50 G-5 01 ... ...
52 G-4 01 ... ...
54 G-5 01 ... ...
56 F-5 01 ... ...
58 D-5 01 ... ...
60 B-4 01 ... ...
62 G-4 01 ... ...

# Drums: kick on 1 and 3, snare on 2 and 4, hats between.
pattern P5
00 C-5 02 ... ...
02 F-6 01 ... ...
04 D-6 03 ... ...
06 F-6 01 ... ...
08 C-5 02 ... ...
10 F-6 01 ... ...
12 D-6 03 ... ...
14 F-6 01 ... ...
16 C-5 02 ... ...
18 F-6 01 ... ...
20 D-6 03 ... ...
22 F-6 01 ... ...

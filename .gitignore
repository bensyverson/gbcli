.DS_Store
# job
# Jobs cache and its sidecars — disposable, rebuilt from .jobs/log
.jobs.db*
# This machine's replica id, identity and focus
.jobs/local.json
# Benchmark build output
scripts/bench/rust-build/target/
# Agent worktrees
.claude/worktrees/
# Cargo build output
/target/
# Test-ROM corpus (fetched by scripts/corpus/fetch.py)
/tests/corpus/fetched
/tests/corpus/.downloads/
# Machine-local inputs (e.g. a GB Studio project and its ROM), never committed
/local/

# gbcli session bundles created by runs in this checkout
.gbcli/

# Web spike (spike/web only): the page's npm dependencies
/crates/web/page/node_modules/

@@ -0,0 +1,228 @@
+use std::fs;
+use std::path::{Path, PathBuf};
+use std::time::{Duration, SystemTime};
+
+use super::*;
+
+/// A scratch directory, removed on drop.
+struct Dir(PathBuf);
+
+impl Dir {
+    fn new(name: &str) -> Dir {
+        let dir = std::env::temp_dir().join(format!(
+            "gbcli-build-probe-cache-{}-{name}",
+            std::process::id()
+        ));
+        let _ = fs::remove_dir_all(&dir);
+        fs::create_dir_all(&dir).unwrap();
+        Dir(dir)
+    }
+
+    fn join(&self, name: &str) -> PathBuf {
+        self.0.join(name)
+    }
+
+    /// A compiled program (the system's `echo`) named `name` here.
+    fn binary(&self, name: &str) -> PathBuf {
+        let path = self.join(name);
+        fs::copy("/bin/echo", &path).unwrap();
+        path
+    }
+
+    /// A subdirectory.
+    fn sub(&self, name: &str) -> Dir {
+        let dir = self.join(name);
+        fs::create_dir_all(&dir).unwrap();
+        // Removed with its parent, not on its own.
+        Dir(dir)
+    }
+}
+
+impl Drop for Dir {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.0);
+    }
+}
+
+/// Long enough after any file this test made that it is not racy.
+fn later() -> SystemTime {
+    SystemTime::now() + Duration::from_secs(3600)
+}
+
+fn id(path: &Path) -> Option<FileId> {
+    FileId::of("rgbasm", path, later())
+}
+
+#[test]
+fn a_program_is_identified_and_the_same_file_has_the_same_id() {
+    let d = Dir::new("same");
+    let path = d.binary("rgbasm");
+    let first = id(&path).expect("a compiled program");
+    assert_eq!(id(&path), Some(first));
+}
+
+#[test]
+fn a_script_is_never_identified() {
+    // A version manager's shim is a script whose answer depends on where it
+    // runs, and a script's file says nothing of what it will print.
+    let d = Dir::new("script");
+    let path = d.join("rgbasm");
+    fs::write(&path, "#!/bin/sh\necho 'rgbasm v1.0.4'\n").unwrap();
+    assert_eq!(id(&path), None);
+}
+
+#[test]
+fn a_file_that_is_not_a_program_is_never_identified() {
+    let d = Dir::new("text");
+    let path = d.join("rgbasm");
+    fs::write(&path, "just some text, long enough to read four bytes").unwrap();
+    assert_eq!(id(&path), None);
+}
+
+#[test]
+fn a_link_to_a_program_of_another_name_is_never_identified() {
+    // mise and rbenv-style shims are links to one dispatcher that picks the
+    // version from the directory it is run in.
+    let d = Dir::new("dispatcher");
+    let dispatcher = d.binary("mise");
+    let shim = d.join("rgbasm");
+    std::os::unix::fs::symlink(&dispatcher, &shim).unwrap();
+    assert_eq!(id(&shim), None);
+    assert!(id(&dispatcher).is_none(), "named for another tool too");
+}
+
+#[test]
+fn a_link_is_identified_by_its_target_and_a_retargeted_link_is_another_id() {
+    let d = Dir::new("retarget");
+    let (a_dir, b_dir) = (d.sub("a"), d.sub("b"));
+    let (a, b) = (a_dir.binary("rgbasm"), b_dir.binary("rgbasm"));
+    let link = d.join("rgbasm");
+    std::os::unix::fs::symlink(&a, &link).unwrap();
+    let through_a = id(&link).expect("a link to a program of its own name");
+    assert_eq!(id(&a), Some(through_a.clone()), "the target's own id");
+    fs::remove_file(&link).unwrap();
+    std::os::unix::fs::symlink(&b, &link).unwrap();
+    let through_b = id(&link).expect("still a program");
+    assert_ne!(through_a, through_b);
+}
+
+#[test]
+fn a_replaced_file_is_another_id_even_with_the_same_bytes() {
+    let d = Dir::new("replaced");
+    let path = d.binary("rgbasm");
+    let before = id(&path).unwrap();
+    fs::remove_file(&path).unwrap();
+    fs::copy("/bin/echo", &path).unwrap();
+    assert_ne!(id(&path).unwrap(), before);
+}
+
+#[test]
+fn an_edit_in_place_is_another_id() {
+    use std::io::Write;
+    let d = Dir::new("edited");
+    let path = d.binary("rgbasm");
+    let before = id(&path).unwrap();
+    fs::OpenOptions::new()
+        .append(true)
+        .open(&path)
+        .unwrap()
+        .write_all(b"x")
+        .unwrap();
+    assert_ne!(id(&path).unwrap(), before, "its size changed");
+}
+
+#[test]
+fn a_touched_file_is_another_id() {
+    let d = Dir::new("touched");
+    let path = d.binary("rgbasm");
+    let before = id(&path).unwrap();
+    let file = fs::OpenOptions::new().write(true).open(&path).unwrap();
+    file.set_modified(SystemTime::now() - Duration::from_secs(86_400))
+        .unwrap();
+    assert_ne!(id(&path).unwrap(), before, "its mtime changed");
+}
+
+#[test]
+fn a_file_changed_within_the_last_two_seconds_is_never_identified() {
+    // It could be rewritten within the same timestamp tick and keep its
+    // size and times.
+    let d = Dir::new("racy");
+    let path = d.binary("rgbasm");
+    assert_eq!(FileId::of("rgbasm", &path, SystemTime::now()), None);
+    assert!(FileId::of("rgbasm", &path, SystemTime::now() + Duration::from_secs(5)).is_some());
+    let before = SystemTime::now() - Duration::from_secs(5);
+    assert_eq!(
+        FileId::of("rgbasm", &path, before),
+        None,
+        "a time in the future is racy"
+    );
+}
+
+#[test]
+fn a_file_missing_is_never_identified() {
+    assert_eq!(id(Path::new("/no/such/rgbasm")), None);
+}
+
+#[test]
+fn the_process_remembers_a_line_for_one_id_only() {
+    let d = Dir::new("memo");
+    let a = id(&d.binary("rgbasm")).unwrap();
+    let other = Dir::new("memo-other");
+    let b = id(&other.binary("rgbasm")).unwrap();
+    let cache = VersionCache::new();
+    assert_eq!(cache.lookup(&a, None), None);
+    cache.remember(&a, None, "rgbasm v1.0.4");
+    assert_eq!(cache.lookup(&a, None).as_deref(), Some("rgbasm v1.0.4"));
+    assert_eq!(cache.lookup(&b, None), None);
+}
+
+#[test]
+fn a_cache_directory_shares_a_line_between_processes() {
+    let d = Dir::new("shared");
+    let cache_dir = d.join("cache");
+    let a = id(&d.binary("rgbasm")).unwrap();
+    VersionCache::new().remember(&a, Some(&cache_dir), "rgbasm v1.0.4");
+    // A fresh memo, as a new process has, finds it on disk.
+    let found = VersionCache::new().lookup(&a, Some(&cache_dir));
+    assert_eq!(found.as_deref(), Some("rgbasm v1.0.4"));
+    assert_eq!(
+        VersionCache::new().lookup(&a, None),
+        None,
+        "with no directory nothing is shared"
+    );
+}
+
+#[test]
+fn an_entry_for_another_file_or_one_that_is_damaged_is_not_believed() {
+    let d = Dir::new("damaged");
+    let cache_dir = d.join("cache");
+    let a = id(&d.binary("rgbasm")).unwrap();
+    VersionCache::new().remember(&a, Some(&cache_dir), "rgbasm v1.0.4");
+    let entry = fs::read_dir(&cache_dir)
+        .unwrap()
+        .map(|e| e.unwrap().path())
+        .next()
+        .expect("an entry");
+    let text = fs::read_to_string(&entry).unwrap();
+    // Another file's key under this file's name: a hash collision.
+    fs::write(&entry, text.replacen(a.text(), "/some/other/rgbasm 1 2", 1)).unwrap();
+    assert_eq!(VersionCache::new().lookup(&a, Some(&cache_dir)), None);
+    fs::write(&entry, "garbage").unwrap();
+    assert_eq!(VersionCache::new().lookup(&a, Some(&cache_dir)), None);
+    fs::write(&entry, "").unwrap();
+    assert_eq!(VersionCache::new().lookup(&a, Some(&cache_dir)), None);
+}
+
+#[test]
+fn an_unwritable_cache_directory_is_not_an_error() {
+    let d = Dir::new("unwritable");
+    let a = id(&d.binary("rgbasm")).unwrap();
+    // The directory's parent is a file, so it can't be made.
+    let blocked = d.join("rgbasm").join("cache");
+    let cache = VersionCache::new();
+    cache.remember(&a, Some(&blocked), "rgbasm v1.0.4");
+    assert_eq!(
+        cache.lookup(&a, Some(&blocked)).as_deref(),
+        Some("rgbasm v1.0.4")
+    );
+}

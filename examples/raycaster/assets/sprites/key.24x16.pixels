format gbcli-pixels 1
# The floating key, by hand: four sizes of one brass key, nearest first, each
# centered on its 24x16 frame's point (12, 8). src/sprite.asm picks a frame by
# the key's distance. Color art: the GBC build keeps the brass; the DMG build
# derives shades (a black outline, so the key reads on any wall or floor).
size 96 16
color . clear
color k #301808   # outline
color g #d89820   # brass
color h #fff0a0   # glint

rows 0 0   # frame 0: near (23x9)
........................

format gbcli-pixels 1
# The scene's background tiles, 8x8 each, left to right in tile order
# (include/layout.inc names them). tools/gen_scene.py turns this file into
# src/gen/scene.asm. Shades as the DMG shows them; on a GBC the wall band
# is pink (its light gray) and the rest gray (src/colors.asm).
size 136 8
color w #ffffff
color l #aaaaaa
color d #555555
color k #000000

rows 0 0    # 0 blank: white, the floor and the title and results screens

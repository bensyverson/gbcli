format gbcli-pixels 1
# Gag glasses: the glasses with the nose, a wide flat mustache, the
# disguise. Three 16x16 frames. Pieces are objects too, so no dark gray:
# clear shows the belt behind them (tools/tiles.py).
size 48 16
color . clear
color w #ffffff
color l #aaaaaa
color k #000000
fill .

rows 0 0    # half A: the glasses and nose

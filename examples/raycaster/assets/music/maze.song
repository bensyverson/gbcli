  envelope 7 down 6
  duty 25%

instrument square 2 "Bell"
  envelope 10 down 2
  duty 12.5%

instrument wave 1 "Bass"
  level 50%
  waveform 4

instrument noise 1 "Drip"
  length 6
  envelope 6 down 1
  mode 7-bit

instrument noise 2 "Step"
  envelope 5 down 1


format gbcli-song 1
# A test song for gbcli's hUGEDriver checks: four channels, a wave
# instrument with a wave change, noise drums, a subpattern instrument, a
# timer tempo, three orders, and every effect hUGEDriver plays but 6xx:
# arpeggio, pitch slides, portamento, vibrato, master volume, note delay,
# panning, duty and wave changes, volume slides, a position jump, set
# volume, a pattern break, a note cut and a speed change. 6xx is left out
# because hUGETracker's RGBDS export can't play it (it writes the routines'
# code where hUGEDriver reads their addresses); see
# project/2026-11-07-music-build.md.
name "Every Effect but 6xx"
artist "gbcli"
comment "CC0 1.0: dedicated to the public domain"
ticks_per_row 4
timer on 192

wave 0 0123456789ABCDEFFEDCBA9876543210
wave 1 FFFFFFFFFFFFFFFF0000000000000000

instrument square 1 "Lead"
  envelope 12 down 0
  duty 50%

instrument square 2 "Pad"
  envelope 8 down 0
  duty 25%

instrument square 3 "Arp"
  envelope 10 down 1
  duty 12.5%
  subpattern on
  00 +00 .. ... ...
  01 +04 .. ... ...
  02 +07 .. J01 ...

instrument wave 1 "Bass"
  level 100%
  waveform 0

instrument noise 1 "Kick"
  envelope 15 down 2

instrument noise 2 "Snare"
  envelope 12 down 3

instrument noise 3 "Hat"
  length 4
  envelope 8 down 1
  mode 7-bit

orders
00 P0 P1 P2 P3
01 P4 P5 P2 P6
02 P7 P8 P9 P10


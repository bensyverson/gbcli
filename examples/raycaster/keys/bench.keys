# The equivalence bench: keys/walk.keys moved to start at frame 120 after
# boot (START at frame 10 leaves the title), with SELECT held at power-on for the frame-locked mode (a view is shown
# only every LOCK_PERIOD frames, so two builds of different speed draw the
# same screen frame for frame). For gbcli equiv, which starts at the boot
# handoff: gbcli equiv build/fast.gb --session base --frames 720 --keys-file keys/bench.keys
SELECT@0 -SELECT@30
START@10 -START@12
RIGHT@120 -RIGHT@135
UP@135 -UP@195
LEFT@195 -LEFT@225
UP@225 -UP@285
RIGHT@285 -RIGHT@325
UP@325 -UP@380
LEFT@380 -LEFT@420
DOWN@420 -DOWN@450
RIGHT@450 -RIGHT@540
UP@540 -UP@600
LEFT@600 RIGHT@600 -LEFT@660 -RIGHT@660
UP@660 -UP@720

format gbcli-song 1
# A test song for gbcli's hUGEDriver checks: four channels, a wave
# instrument, noise drums, arpeggio, vibrato, portamento, pitch slides,
# volume slides, a note cut, an order change and a timer tempo.
name "Every Effect"
artist "gbcli"
comment "CC0 1.0: dedicated to the public domain"
ticks_per_row 4
timer on 192

wave 0 0123456789ABCDEFFEDCBA9876543210

instrument square 1 "Lead"
  envelope 12 down 0
  duty 50%

instrument square 2 "Pad"
  envelope 8 down 0
  duty 25%

instrument wave 1 "Bass"
  level 100%
  waveform 0

instrument noise 1 "Kick"
  envelope 15 down 2

instrument noise 2 "Snare"
  envelope 12 down 3

instrument noise 3 "Hat"
  length 4
  envelope 8 down 1
  mode 7-bit

orders
00 P0 P1 P2 P3
01 P4 P5 P2 P6


format gbcli-song 1
name "Lantern Drum"
artist "rhythm15"
comment "Channel 1 is the chart (tools/chart.py); channel 2 is the effects'."
ticks_per_row 7
timer off

instrument square 1 "Lead"
  envelope 12 down 2
  duty 50%

instrument square 2 "Soft lead"
  envelope 9 down 3
  duty 25%

instrument wave 1 "Bass"
  level 50%
  waveform 4

instrument noise 1 "Hat"
  length 4
  envelope 6 down 1
  mode 7-bit

instrument noise 2 "Kick"
  envelope 15 down 2

instrument noise 3 "Snare"
  envelope 12 down 2


format gbcli-pixels 1
# Crayons: a bundle of pointed crayons, an open box (the only box), the
# crayons in their box. Three 16x16 frames. Pieces are objects too, so no
# dark gray: clear shows the belt behind them (tools/tiles.py).
size 48 16
color . clear
color w #ffffff
color l #aaaaaa
color k #000000
fill .

rows 0 0    # half A: the crayons
..k....k....k...
.klk..kwk..klk..
.klk..kwk..klk..
klllkkwwwkklllk.
kkkkkkkkkkkkkkk.
klllkkwwwkklllk.
klllkkwwwkklllk.
kkkkkkkkkkkkkkk.
kwwwkklllkkwwwk.
kkkkkkkkkkkkkkk.
klllkkwwwkklllk.
klllkkwwwkklllk.
klllkkwwwkklllk.
klllkkwwwkklllk.
kkkkkkkkkkkkkkk.
................

rows 16 0   # half B: the open box
................
................
kk............kk
klk..........klk
.klkkkkkkkkkklk.
..kwwwwwwwwwwk..
..kkkkkkkkkkkk..
..kllllllllllk..
..klkkkkkkkklk..
..klkwwwwwwklk..
..klkwwwwwwklk..
..klkkkkkkkklk..
..kllllllllllk..
..kllllllllllk..
..kkkkkkkkkkkk..
................

rows 32 0   # the crayons in their box
...k...k...k....
..klk.kwk.klk...
..klk.kwk.klk...
..klk.kwk.klk...
..klk.kwk.klk...
..kkkkkkkkkkkk..
..kllllllllllk..
..klkkkkkkkklk..
..klkwwwwwwklk..
..klkwwwwwwklk..
..kllllllllllk..
..kllllllllllk..
..kllllllllllk..
..kkkkkkkkkkkk..
................
................

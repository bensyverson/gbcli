+//! Remembering what a tool's `--version` said, so a build doesn't run three
+//! processes to learn what the files already say.
+//!
+//! A line is believed only for the file it was read from, as that file is
+//! identified by [`FileId`], and only for files whose identity says what they
+//! will print: a compiled program with the tool's own name. A script (a
+//! version manager's shim, a user's wrapper) or a link to a dispatcher named
+//! for something else (mise's shims) picks its version from where it is run,
+//! so what its file says is no promise, and it is run every time.
+//!
+//! The lines are kept for the life of the process and, when the caller names
+//! a directory (`GBCLI_CACHE`), in files there that other processes read.
+
+use std::collections::HashMap;
+use std::collections::hash_map::DefaultHasher;
+use std::fs;
+use std::hash::{Hash, Hasher};
+use std::io::Read;
+use std::path::{Path, PathBuf};
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::{Duration, SystemTime};
+
+/// A file modified this recently could be rewritten within the same
+/// timestamp tick and keep its size and times.
+const RACY: Duration = Duration::from_secs(2);
+
+/// The first bytes of the program formats a compiled tool starts with:
+/// Mach-O (both byte orders, 32 and 64 bit, and a universal binary) and ELF.
+/// Anything else, `#!` above all, is a script.
+const MAGIC: [&[u8]; 7] = [
+    &[0xfe, 0xed, 0xfa, 0xce],
+    &[0xfe, 0xed, 0xfa, 0xcf],
+    &[0xce, 0xfa, 0xed, 0xfe],
+    &[0xcf, 0xfa, 0xed, 0xfe],
+    &[0xca, 0xfe, 0xba, 0xbe],
+    &[0xbe, 0xba, 0xfe, 0xca],
+    &[0x7f, b'E', b'L', b'F'],
+];
+
+/// A tool file as it was when its version was read: where it really is (every
+/// link resolved, so a link retargeted elsewhere is another file), its size,
+/// modification and status-change times, and its device and inode. The status
+/// change time can't be set by a program, so a file edited in place, replaced
+/// or touched is another id even if it keeps its size and modification time.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(super) struct FileId {
+    text: String,
+}
+
+impl FileId {
+    /// The id of the file `found` is the path of for `tool`, as of `now`, or
+    /// `None` when its version can't be taken from the file alone: it isn't a
+    /// compiled program, isn't named `tool` once links are resolved, changed
+    /// within [`RACY`] of `now`, or the host can't say (not unix).
+    pub(super) fn of(tool: &str, found: &Path, now: SystemTime) -> Option<FileId> {
+        let real = fs::canonicalize(found).ok()?;
+        let name = format!("{tool}{}", std::env::consts::EXE_SUFFIX);
+        if real.file_name()? != name.as_str() {
+            return None;
+        }
+        let stat = fs::metadata(&real).ok()?;
+        if !stat.is_file() || !is_program(&real) {
+            return None;
+        }
+        let (times, device, inode) = unix_identity(&stat)?;
+        let recent = [stat.modified().ok()?, times.changed_at]
+            .into_iter()
+            .any(|changed| now.duration_since(changed).map_or(true, |age| age < RACY));
+        if recent {
+            return None;
+        }
+        Some(FileId {
+            text: format!(
+                "{} {} {} {} {device}:{inode}",
+                real.display(),
+                stat.len(),
+                times.modified,
+                times.changed,
+            ),
+        })
+    }
+
+    pub(super) fn text(&self) -> &str {
+        &self.text
+    }
+}
+
+/// Whether the file starts like a compiled program.
+fn is_program(path: &Path) -> bool {
+    let mut head = [0u8; 4];
+    fs::File::open(path)
+        .and_then(|mut file| file.read_exact(&mut head))
+        .is_ok()
+        && MAGIC.contains(&head.as_slice())
+}
+
+/// A file's modification and status-change times as seconds and nanoseconds.
+struct Times {
+    modified: String,
+    changed: String,
+    changed_at: SystemTime,
+}
+
+#[cfg(unix)]
+fn unix_identity(stat: &fs::Metadata) -> Option<(Times, u64, u64)> {
+    use std::os::unix::fs::MetadataExt;
+    let changed_at = match u64::try_from(stat.ctime()) {
+        Ok(secs) => {
+            SystemTime::UNIX_EPOCH + Duration::new(secs, u32::try_from(stat.ctime_nsec()).ok()?)
+        }
+        Err(_) => return None,
+    };
+    let times = Times {
+        modified: format!("{}.{:09}", stat.mtime(), stat.mtime_nsec()),
+        changed: format!("{}.{:09}", stat.ctime(), stat.ctime_nsec()),
+        changed_at,
+    };
+    Some((times, stat.dev(), stat.ino()))
+}
+
+#[cfg(not(unix))]
+fn unix_identity(_: &fs::Metadata) -> Option<(Times, u64, u64)> {
+    None
+}
+
+/// The version lines remembered: in memory, and in a shared directory.
+#[derive(Debug, Default)]
+pub(super) struct VersionCache {
+    memo: Mutex<HashMap<String, String>>,
+}
+
+/// Distinguishes the temporary files one process writes.
+static TEMP_SEQ: AtomicU64 = AtomicU64::new(0);
+
+impl VersionCache {
+    pub(super) fn new() -> VersionCache {
+        VersionCache::default()
+    }
+
+    /// The line read from the file `id` names: this process's, else the one
+    /// in `dir`, which must say it is for this very id.
+    pub(super) fn lookup(&self, id: &FileId, dir: Option<&Path>) -> Option<String> {
+        if let Some(line) = self.memo().get(id.text()) {
+            return Some(line.clone());
+        }
+        let line = read_entry(&entry_path(dir?, id), id)?;
+        self.memo().insert(id.text().to_string(), line.clone());
+        Some(line)
+    }
+
+    /// Keeps `line` for the file `id` names, in `dir` too when one is given.
+    /// A directory that can't be written is no loss: the next process reads
+    /// the version itself.
+    pub(super) fn remember(&self, id: &FileId, dir: Option<&Path>, line: &str) {
+        self.memo().insert(id.text().to_string(), line.to_string());
+        if let Some(dir) = dir {
+            let _ = write_entry(dir, id, line);
+        }
+    }
+
+    fn memo(&self) -> std::sync::MutexGuard<'_, HashMap<String, String>> {
+        self.memo
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner())
+    }
+}
+
+/// Where `id`'s line is kept under `dir`: a name from a hash of the id, whose
+/// file repeats the id so a collision is seen.
+fn entry_path(dir: &Path, id: &FileId) -> PathBuf {
+    let mut hasher = DefaultHasher::new();
+    id.text().hash(&mut hasher);
+    dir.join(format!("rgbds-{:016x}.txt", hasher.finish()))
+}
+
+/// The line in the entry at `path`, if it is `id`'s and whole.
+fn read_entry(path: &Path, id: &FileId) -> Option<String> {
+    let text = fs::read_to_string(path).ok()?;
+    let mut lines = text.lines();
+    if lines.next()? != id.text() {
+        return None;
+    }
+    let line = lines.next()?;
+    (!line.is_empty() && lines.next().is_none() && text.ends_with('\n')).then(|| line.to_string())
+}
+
+/// Writes `id`'s entry, replacing any, so a reader sees the old entry or the
+/// new one.
+fn write_entry(dir: &Path, id: &FileId, line: &str) -> std::io::Result<()> {
+    fs::create_dir_all(dir)?;
+    let path = entry_path(dir, id);
+    let temp = path.with_extension(format!(
+        "tmp-{}-{}",
+        std::process::id(),
+        TEMP_SEQ.fetch_add(1, Ordering::Relaxed)
+    ));
+    fs::write(&temp, format!("{}\n{line}\n", id.text()))?;
+    fs::rename(&temp, &path).inspect_err(|_| {
+        let _ = fs::remove_file(&temp);
+    })
+}
+
+/// The process's own cache, shared by every build it answers.
+pub(super) static PROCESS: std::sync::LazyLock<VersionCache> =
+    std::sync::LazyLock::new(VersionCache::new);
+
+#[cfg(test)]
+mod tests;

--- /dev/null
+++ b/crates/gbcli/tests/cli/build_cache.rs
@@ -0,0 +1,85 @@
+//! `GBCLI_CACHE`: processes share what they learned about the installed
+//! RGBDS, so a build doesn't run `--version` on all three tools again. Needs
+//! the pinned RGBDS on `PATH`, like `rgbds.rs`.
+
+use std::fs;
+use std::path::PathBuf;
+
+use crate::common::{Project, Run};
+use crate::rgbds::rgbds_dir;
+
+fn entries(cache: &PathBuf) -> Vec<PathBuf> {
+    fs::read_dir(cache)
+        .map(|dir| dir.map(|e| e.unwrap().path()).collect())
+        .unwrap_or_default()
+}
+
+/// `gbcli build game --json` with the pinned RGBDS on `PATH` and `cache` as
+/// `GBCLI_CACHE`, when given.
+fn build(p: &Project, cache: Option<&PathBuf>) -> Run {
+    let path = rgbds_dir();
+    let mut env = vec![("PATH", path.as_str())];
+    if let Some(cache) = cache {
+        env.push(("GBCLI_CACHE", cache.to_str().unwrap()));
+    }
+    p.gbcli_with(&["build", "game", "--json"], &env, None)
+}
+
+fn project(name: &str) -> Project {
+    let p = Project::new(name);
+    let made = p.rgbds(&["new", "game"]);
+    assert_eq!(made.code, 0, "{}", made.stderr);
+    p
+}
+
+#[test]
+fn a_build_leaves_one_entry_a_tool_and_the_next_build_believes_them() {
+    let p = project("cache-believed");
+    let cache = p.path("shared-cache");
+    let first = build(&p, Some(&cache));
+    assert_eq!(first.code, 0, "{}{}", first.stdout, first.stderr);
+    assert!(!first.stdout.contains("not the pinned"), "{}", first.stdout);
+    let found = entries(&cache);
+    assert_eq!(found.len(), 3, "{found:?}");
+
+    // An entry that says another patch: the next process takes its word, so
+    // its build carries the unpinned-version warning a real 1.0.9 would earn.
+    let rgbasm = found
+        .iter()
+        .find(|e| fs::read_to_string(e).unwrap().contains("\nrgbasm v"))
+        .expect("an entry for rgbasm");
+    let text = fs::read_to_string(rgbasm).unwrap();
+    let key = text.lines().next().unwrap();
+    fs::write(rgbasm, format!("{key}\nrgbasm v1.0.9\n")).unwrap();
+    let second = build(&p, Some(&cache));
+    assert_eq!(second.code, 0, "{}{}", second.stdout, second.stderr);
+    assert!(
+        second.stdout.contains("rgbasm is 1.0.9, not the pinned"),
+        "{}",
+        second.stdout
+    );
+
+    // Without the variable nothing is believed or written.
+    let alone = build(&p, None);
+    assert_eq!(alone.code, 0, "{}{}", alone.stdout, alone.stderr);
+    assert!(!alone.stdout.contains("not the pinned"), "{}", alone.stdout);
+}
+
+#[test]
+fn doctor_reads_the_tools_itself() {
+    let p = project("cache-doctor");
+    let cache = p.path("shared-cache");
+    assert_eq!(build(&p, Some(&cache)).code, 0);
+    let entry = entries(&cache).into_iter().next().expect("an entry");
+    let text = fs::read_to_string(&entry).unwrap();
+    let key = text.lines().next().unwrap();
+    fs::write(&entry, format!("{key}\nrgbasm v9.9.9\n")).unwrap();
+    let path = rgbds_dir();
+    let env = [
+        ("PATH", path.as_str()),
+        ("GBCLI_CACHE", cache.to_str().unwrap()),
+    ];
+    let doctor = p.gbcli_with(&["doctor"], &env, None);
+    assert!(!doctor.stdout.contains("9.9.9"), "{}", doctor.stdout);
+    assert!(!doctor.stderr.contains("9.9.9"), "{}", doctor.stderr);
+}
